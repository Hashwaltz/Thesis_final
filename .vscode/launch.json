{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flask Debug",
            "type": "debugpy",
            "request": "launch",
            "module": "main_app.run",
            "console": "integratedTerminal",
            "env": {
                "FLASK_DEBUG": "1",
                "FLASK_APP": "main_app.run"
            },
            "justMyCode": true,
            "stopOnEntry": false,
            "subProcess": true,
            "redirectOutput": true
        }
    ]
}